rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nova fronteira de acesso. Clientes antigos continuam nas coleções legadas.
    // Vínculos e documentos públicos só podem ser provisionados pelo servidor.
    function adminV2() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function identidadeMembroV2(lojaId, membro) {
      let terminal = /databases/$(database)/documents/terminais_v2/$(request.auth.uid);
      return (membro.get('tipo', '') == 'usuario'
          && request.auth.token.get('email_verified', false) == true
          && !exists(terminal))
        || (membro.get('tipo', '') == 'terminal'
          && membro.papel in ['caixa', 'cozinha']
          && exists(terminal)
          && get(terminal).data.ativo == true
          && get(terminal).data.lojaId == lojaId
          && get(terminal).data.papel == membro.papel);
    }

    function papelV2(lojaId, papeis) {
      return request.auth != null && (
        adminV2() || (
          get(/databases/$(database)/documents/lojas_v2/$(lojaId)).data.ativo == true
          && exists(/databases/$(database)/documents/lojas_v2/$(lojaId)/membros/$(request.auth.uid))
          && get(/databases/$(database)/documents/lojas_v2/$(lojaId)/membros/$(request.auth.uid)).data.ativo == true
          && get(/databases/$(database)/documents/lojas_v2/$(lojaId)/membros/$(request.auth.uid)).data.papel in papeis
          && identidadeMembroV2(lojaId, get(/databases/$(database)/documents/lojas_v2/$(lojaId)/membros/$(request.auth.uid)).data)
        )
      );
    }

    match /lojas_v2/{lojaId} {
      match /atendimentos/{atendimentoId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa', 'cozinha']);
        allow write: if false;
      }
      match /impressoes_cozinha/{jobId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa', 'cozinha']);
        allow write: if false;
      }
      match /vendas/{vendaId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa']);
        allow write: if false;
      }
      match /estoque/{itemId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa']);
        allow write: if false;
      }
      match /movimentos_financeiros/{id} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa']);
        allow write: if false;
      }
      match /movimentos_estoque/{id} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa']);
        allow write: if false;
      }
      match /avisos_cozinha/{id} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa', 'cozinha']);
        allow write: if false;
      }
      allow get: if papelV2(lojaId, ['gerente', 'caixa', 'cozinha']);
      allow list, write: if false;

      match /membros/{uid} {
        allow get: if papelV2(lojaId, ['gerente'])
          || (request.auth != null && request.auth.uid == uid
            && papelV2(lojaId, ['gerente', 'caixa', 'cozinha']));
        allow list, write: if false;
      }

      // Só dados operacionais de preparo, sem endereço ou credenciais.
      match /pedidos/{pedidoId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa', 'cozinha']);
        allow create, delete: if false;
        allow update: if false; // Preparo e cancelamento passam pelas transações do servidor.
      }

      // Separados para não expor contato/endereço ao monitor da cozinha.
      match /dados_entrega/{pedidoId} {
        allow read: if papelV2(lojaId, ['gerente', 'caixa']);
        allow write: if false;
      }
    }

    // Slug é público e independente de licença, UID ou credencial.
    match /catalogos_publicos_v2/{slug} {
      allow get: if resource.data.publicado == true;
      allow list, write: if false;
    }
    match /rotas_publicas_v2/{slug} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'dougnvds26@gmail.com'
        || request.auth.token.email == 'admin@flowpdv.com.br'
        || request.auth.token.email == 'contato@flowpdv.com.br'
        || request.auth.token.admin == true
      );
    }

    // Conta de maquina do PDV: a chave da licenca vira o e-mail de acesso, entao
    // uma loja nunca consegue ler nem escrever no espaco da outra.
    function emailDaLoja(chave) {
      return 'loja_' + chave.lower() + '@pdv.flowpdv.com.br';
    }

    function isLoja(chave) {
      return request.auth != null
        && request.auth.token.email == emailDaLoja(chave);
    }

    // A loja mexe só no que é operação dela. Plano, vencimento, status e limite
    // de terminais continuam sendo exclusividade do painel admin.
    function soCamposDoPdv() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['terminaisAtivos', 'atualizadoEm', 'categorias', 'categoriasExcluidas', 'modulos'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['modulos'])
          || soModulosOperacionais()
        );
    }

    // Módulos cobrados (NFC-e, TEF, balança) não entram nesta lista: a loja não
    // pode se liberar recurso pago pelo app do gestor.
    function soModulosOperacionais() {
      return resource.data.keys().hasAll(['modulos'])
        && request.resource.data.modulos.diff(resource.data.modulos).affectedKeys()
          .hasOnly(['validadeLotes', 'fiadoWhatsApp', 'comandasMesas', 'descontoMaximo']);
    }

    // O id do documento nem sempre e a chave da licenca; aceitamos os dois.
    function isLojaDaLicenca(chave) {
      return isLoja(chave)
        || (resource != null && isLoja(resource.data.get('chaveLicenca', chave)));
    }

    match /licencas/{chave} {
      allow get: if isAdmin() || isLojaDaLicenca(chave);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isLojaDaLicenca(chave) && soCamposDoPdv());
    }

    function legadoGravavel(chave) {
      return chave != 'LIC-FLOW-937278'
        || !exists(/databases/$(database)/documents/lojas_v2/legado-lic-flow-937278)
        || get(/databases/$(database)/documents/lojas_v2/legado-lic-flow-937278).data.get('corteOperacionalV2', {}).get('legadoBloqueado', false) != true;
    }

    match /backups_lojas/{chave} {
      allow get: if isAdmin() || isLoja(chave);
      allow write: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      allow list: if false;

      match /partes/{parte} {
        allow read: if isAdmin() || isLoja(chave);
        allow write: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      }

      match /movimentos/{movimento} {
        allow read: if isAdmin() || isLoja(chave);
        allow write: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      }

      match /checkpoint/{docId} {
        allow read: if isAdmin() || isLoja(chave);
        allow write: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      }

      match /inventarios/{inventarioId} {
        allow read: if isAdmin() || isLoja(chave);
        allow write: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      }

      // Logs de auditoria da loja: a loja le, grava e apaga so o que e dela.
      match /auditoria/{logId} {
        allow read, create, update, delete: if isAdmin() || isLoja(chave);
      }

      // Pedidos do cardápio online: painel da loja atualiza status mesmo com corte V2.
      // Create/delete de estoque legado continua sob legadoGravavel.
      match /pedidos/{pedidoId} {
        allow read: if isAdmin() || isLoja(chave);
        allow update: if isAdmin() || isLoja(chave);
        allow create, delete: if isAdmin() || (isLoja(chave) && legadoGravavel(chave));
      }
    }

    // Overlay do cardápio: foto/visível/descrição fora do backup do PDV.
    // Continua gravável com o corte V2 — o bloqueio de legado é só estoque/venda local.
    match /cardapio_config/{chave} {
      allow get: if isAdmin() || isLoja(chave);
      allow write: if isAdmin() || isLoja(chave);
      allow list: if false;
      match /produtos/{produtoId} {
        allow read: if isAdmin() || isLoja(chave);
        allow write: if isAdmin() || isLoja(chave);
      }
    }

    // Cópia sanitizada para o cliente no celular. Anônimo só lê o doc da chave.
    match /cardapio_publico/{chave} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || isLoja(chave);
    }

    // Acompanhamento do pedido pelo link (id difícil de adivinhar). Sem listar todos.
    match /cardapio_pedidos/{id} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create: if isAdmin() || isLoja(request.resource.data.chaveLicenca);
      allow update: if request.auth != null
        && isLoja(resource.data.chaveLicenca)
        && request.resource.data.chaveLicenca == resource.data.chaveLicenca
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm']);
    }

    match /backups_adegas/{chave} {
      allow get, write: if isAdmin() || isLoja(chave);
      allow list: if false;
    }

    // A loja le, grava e apaga so a propria auditoria (sempre filtrada por chave).
    match /auditoria_lojas/{id} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['chaveLicenca'])
        && isLoja(request.resource.data.chaveLicenca)
      );
      allow get, list: if isAdmin() || (
        resource.data.keys().hasAll(['chaveLicenca'])
        && isLoja(resource.data.chaveLicenca)
      );
      allow update, delete: if isAdmin() || (
        resource.data.keys().hasAll(['chaveLicenca'])
        && isLoja(resource.data.chaveLicenca)
      );
    }
  }
}
